if ! has devenv; then
  log_error "devenv is required for this repository. Install devenv and direnv first."
  exit 1
fi

export DIRENV_LOG_FORMAT=

eval "$(devenv direnvrc)"

eval "$(declare -f _nix_import_env | sed 's/_nix_import_env/_nix_import_env_original/')"
_nix_import_env() {
  local env=$1
  env=$(
    printf '%s\n' "$env" | awk '
      found || /^[A-Za-z_][A-Za-z0-9_]*=/ || /^declare -/ {
        found = 1
        print
      }
    '
  )
  _nix_import_env_original "$env"
}

use devenv 2> >(
  grep --invert-match --extended-regexp \
    --regexp='^(•|✓) ' \
    --regexp='^💡 The dotenv file ' \
    >&2
)

if [[ -d .venv && -x .venv/bin/python ]]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add .venv/bin
fi
